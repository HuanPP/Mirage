# Mirage launcher config example.
# Copy to ~/.config/mirage/launcher.conf (or point MIRAGE_LAUNCHER_CONF at a copy).
# Format: key=value, one per line. Blank lines and # comments are ignored.
# If the conf file is missing, mirage-launch uses the defaults shown here.

# Profile name. Default Chrome user-data-dir is ~/.mirage/profiles/<profile>
# This is a throwaway profile; it is never the owner's existing Chrome profile.
# profile=us-west

# IANA timezone, or "auto".
# auto queries egress IP geo via curl -4 (5s timeout each), first valid zone wins:
#   https://ipinfo.io/timezone
#   https://ipapi.co/timezone
#   https://worldtimeapi.org/api/ip   (JSON; uses .timezone)
#   http://ip-api.com/line?fields=timezone
# Validated against /usr/share/zoneinfo. Never falls back to this Mac's zone.
# Chrome is exec'd with TZ=<zone> (ICU on this macOS honors TZ when exec'd
# directly). This script never runs `sudo systemsetup -settimezone` and never
# changes /etc/localtime.
# timezone=auto
# timezone=America/Los_Angeles

# Chrome UI language and --accept-lang=<lang>,en
# lang=en-US

# Stock Chrome binary. Exec'd directly; not launched via `open`.
# chrome=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# First page loaded after Chrome starts.
# start_url=about:blank

# Extra Chrome flags, whitespace-separated, appended as-is before start_url.
# Empty means none. Do not eval. Do not put --remote-debugging-port here
# in production (production never opens a debugging port).
# extra_flags=

# Optional. If unset or empty, defaults to ~/.mirage/profiles/<profile>
# user_data_dir=

# Expected VPS public IPv4 from the imported Mirage profile.
# mirage-launch resolves the current egress IPv4 and refuses to start
# (unless --force) when it differs: tunnel not active or wrong node.
# timezone=auto is resolved only after this check passes.
# expect_egress=
